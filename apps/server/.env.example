# Sao chép thành .env rồi sửa. File .env không được đưa lên git.

# --- Database chạy app ---
# Cách 1: Postgres trong Docker (npm run db:up)
DATABASE_URL=postgres://tandem:tandem_dev@localhost:5433/tandem
# Cách 2: Supabase — lấy ở nút "Connect" → "Session pooler" (cổng 5432, KHÔNG dùng 6543).
#   Mật khẩu có ký tự đặc biệt (@ : / # ? %) thì phải mã hóa URL, ví dụ @ → %40.
#   Không thêm ?sslmode=... vào cuối; SSL được bật tự động cho DB không nằm trên máy.
# DATABASE_URL=postgresql://postgres.<project-ref>:<mat-khau>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Tùy chọn: chứng chỉ CA của Supabase (Project Settings → Database → SSL Configuration → Download certificate)
# để xác minh chứng chỉ server. Đường dẫn tính từ thư mục apps/server.
# DATABASE_CA_FILE=certs/supabase-ca.crt
# Supabase gói Free giới hạn số kết nối của session pooler.
# DATABASE_POOL_MAX=5

# --- Database cho test: LUÔN là Postgres trên máy, vì test xóa sạch database mỗi lần chạy ---
TEST_DATABASE_URL=postgres://tandem:tandem_dev@localhost:5433/tandem_test

JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai
PORT=4000
